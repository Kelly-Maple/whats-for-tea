rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The shared recipe book. Anyone using the app can read it and add to it;
    // people can only change or delete the recipes they added themselves.
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.ing is list
        && request.resource.data.ing.size() <= 40
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 20;
      allow update, delete: if request.auth != null && resource.data.by == request.auth.uid;
    }
    // Nothing else is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
